# ─── Backend ───────────────────────────────────────────────────────────────
# Laravel backend manzili (faqat server tomonda, rewrite-proxy uchun).
# Dev:  http://127.0.0.1:8000
# Prod: https://admin.gspi.uz  ← MAJBURIY https, backend boshqa serverda turadi
BACKEND_URL=http://127.0.0.1:8000

# Laravel API prefiksi. Backenddagi .env dagi API_PREFIX bilan AYNAN bir xil.
# Brauzerga ko'rinmaydi — Next server tomonda /api/* ni shu prefiksga uzatadi.
# DIQQAT: bu qiymat `npm run build` dan OLDIN o'rnatilgan bo'lishi kerak —
# proxy manzili build paytida .next/ ichiga yoziladi.
BACKEND_API_PREFIX=api

# Brauzer tomonidagi API bazasi. "/api" qoldirilsa proxy ishlatiladi (CORS yo'q).
NEXT_PUBLIC_API_URL=/api

# ─── Sayt ──────────────────────────────────────────────────────────────────
# Kanonik manzil — sitemap, robots.txt, Open Graph va JSON-LD uchun.
NEXT_PUBLIC_SITE_URL=https://gspi.uz
